pipeline {
    agent none

    parameters {
        choice(
            name: 'ENV',
            choices: ['dev', 'qa', 'prod'],
            description: 'Choose deployment environment'
        )
        booleanParam(
            name: 'RUN_SECURITY_CHECKS',
            defaultValue: true,
            description: 'Run security scan'
        )
    }

    environment {
        APP_NAME   = 'node-app'
        IMAGE_NAME = 'gowdaamith/node-app'
        IMAGE_TAG  = "${env.BUILD_NUMBER}"
        APP_DIR = 'Project-1/node-app'
    }

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        /* ---------------- Checkout ---------------- */
        stage('Checkout') {
            agent any
            steps {
                checkout scm
                dir(APP_DIR) {
                    stash name: 'source', includes: '**/*'
                }
            }
        }

        /* ---------------- Install & Test ---------------- */
        stage('Install & Test') {
            agent {
                docker { image 'node:18-slim' }
            }
            steps {
                dir(APP_DIR) {
                    unstash 'source'
                    sh '''
                        npm ci
                        npm test
                    '''
                    stash name: 'deps', includes: 'node_modules/**'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'node-app/test-results/**', allowEmptyArchive: true
                }
            }
        }

        /* ---------------- Parallel Checks ---------------- */
        stage('Parallel Checks') {
            parallel {

                stage('Lint') {
                    agent {
                        docker { image 'node:18-slim' }
                    }
                    steps {
                        dir(APP_DIR) {
                            unstash 'source'
                            unstash 'deps'
                            sh 'npm run lint'
                        }
                    }
                }

                stage('Security Scan') {
                    when {
                        expression { params.RUN_SECURITY_CHECKS }
                    }
                    agent {
                        docker { image 'aquasec/trivy:latest' }
                    }
                    steps {
                        dir(APP_DIR) {
                            unstash 'source'
                            sh 'trivy fs .'
                        }
                    }
                }
            }
        }

        /* ---------------- Docker Build ---------------- */
        stage('Build Docker Image') {
            agent { label 'docker' }
            steps {
                dir(APP_DIR) {
                    unstash 'source'
                    script {
                        dockerImage = docker.build("${IMAGE_NAME}:${IMAGE_TAG}")
                    }
                }
            }
        }

        /* ---------------- Push Image ---------------- */
        stage('Push Image') {
            agent { label 'docker' }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    '''
                }
            }
        }

        /* ---------------- Deploy (Docker Run) ---------------- */
        stage('Deploy') {
            when {
                allOf {
                    expression { currentBuild.result != 'FAILURE' }
                    anyOf {
                        expression { params.ENV == 'qa' }
                        expression { params.ENV == 'prod' }
                    }
                }
            }
            agent { label 'docker' }
            input {
                message "Deploy to ${params.ENV}?"
                ok "Deploy"
            }
            steps {
                sh '''
                    docker stop node-app || true
                    docker rm node-app || true
                    docker run -d -p 3000:3000 --name node-app ${IMAGE_NAME}:${IMAGE_TAG}
                '''
            }
        }
    }

    /* ---------------- Post ---------------- */
    post {
        always {
            echo "Build finished: ${env.JOB_NAME} #${env.BUILD_NUMBER}"
        }
        success {
            script {
                currentBuild.displayName = "#${env.BUILD_NUMBER} ✅"
            }
        }
        unstable {
            script {
                currentBuild.displayName = "#${env.BUILD_NUMBER} ⚠️"
            }
        }
        failure {
            script {
                currentBuild.displayName = "#${env.BUILD_NUMBER} ❌"
            }
        }
    }
}
